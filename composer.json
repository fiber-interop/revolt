{
    "name": "fiber-interop/revolt",
    "description": "Revolt event loop adapter for fiber-interop/api: go, await, sleep, readable, writable on Revolt (AMPHP v3, ReactPHP).",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "fiber-interop/api": "^0.2",
        "revolt/event-loop": "^1.0",
        "fiber-interop/scope": "^0.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11",
        "amphp/amp": "^3.0",
        "react/promise": "^3.0"
    },
    "suggest": {
        "amphp/amp": "await() accepts Amp\\Future natively",
        "react/promise": "await() accepts React promises natively"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "FiberInterop\\Revolt\\": "src/"
        },
        "files": [
            "src/register.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "FiberInterop\\Revolt\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
